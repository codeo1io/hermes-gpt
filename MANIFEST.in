include README.md
include pyproject.toml
include CHANGELOG.md
# Public-safe docs only. Internal counsel/design/release-planning packets
# (docs/design/*, docs/releases/*) are intentionally NOT distributed.
include docs/README.md
include docs/codex.md
include docs/operator-mode.md
include docs/mcp-compatibility.md
include docs/oauth.md
include docs/release-notes-v0.2.0.md
include docs/release-notes-v0.3.0.md
include docs/release-notes-v0.4.0.md
include docs/release-notes-v0.5.0b1.md
include docs/release-notes-v0.5.0b2.md
include docs/release-notes-v0.5.0.md
include docs/release-notes-v0.6.0.md
include docs/release-notes-v0.7.0.md
include docs/release-notes-v0.8.0.md
include docs/retention-policy.md
include docs/updating.md
include docs/windows-chatgpt-codex.md
include docs/ui-security-boundary.md
include docs/flight-deck-coverage.md
include docs/gemini-spark.md
include docs/autopilot.md
recursive-include examples *.ps1
prune docs/design
prune docs/releases
prune logs
prune dist
prune build
prune tmp-operator-test
prune __pycache__
prune .pytest_cache
global-exclude *.py[cod] *.log *.err.log .env .env.* *.pem
# Web UI + README hero truth (rm-191): the sdist must carry the built SPA
# (web/dist) and the README hero images under assets/. NOTE: `prune dist`
# above strips EVERY directory named dist — including web/dist — so these
# grafts must stay AFTER it. web/dist is a build product (never committed):
# build it first (`cd web && npm ci && npm run build`) or
# tools/check_package_hygiene.py fails the release with missing_web_assets.
graft assets
graft web/dist

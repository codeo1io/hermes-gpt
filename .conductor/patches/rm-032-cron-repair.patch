+# --- Repo-local schedule parsing (port of the Hermes agent-runtime parser) ---
+# Ported from the private Hermes runtime (cron/jobs.py) so operator cron jobs
+# persist the same structured schedule schema the deployed scheduler consumes
+# WITHOUT importing modules that do not exist in this repository. The
+# 2026-09-22 convergence introduced `from cron.jobs import parse_schedule`
+# here; `cron` exists only on deployed boxes, so every clean install failed
+# the five cron-create tests (all 9 CI test lanes red). One deliberate
+# deviation from the private original: croniter is OPTIONAL (this package
+# does not depend on it) — cron expressions get the same croniter validation
+# when croniter is present and a structural field check when it is not.
+
+_DURATION_MULTIPLIERS = {"m": 1, "h": 60, "d": 1440}
+
+# Cron weekday numbering is 0=Sunday ... 6=Saturday (croniter's default).
+_WEEKDAY_TO_CRON_DOW = {
+    "sunday": "0", "sun": "0",
+    "monday": "1", "mon": "1",
+    "tuesday": "2", "tue": "2", "tues": "2",
+    "wednesday": "3", "wed": "3", "weds": "3",
+    "thursday": "4", "thu": "4", "thur": "4", "thurs": "4",
+    "friday": "5", "fri": "5",
+    "saturday": "6", "sat": "6",
+}
+
+_DAYSPEC_TO_CRON_DOW = {
+    "day": "*", "daily": "*", "everyday": "*",
+    "weekday": "1-5", "weekdays": "1-5",
+    "weekend": "0,6", "weekends": "0,6",
+}
+
+_CRON_FIELD_RE = re.compile(r"^[A-Za-z\d\*/,\-]+$")
+
+
+def _parse_duration_minutes(value: str) -> int:
+    """Port of the runtime parser: "30m" -> 30, "2h" -> 120, "1d" -> 1440, bare "hour" -> 60."""
+    text = value.strip().lower()
+    match = re.match(r"^(\d*)\s*(m|min|mins|minute|minutes|h|hr|hrs|hour|hours|d|day|days)$", text)
+    if not match:
+        raise ValueError(
+            f"Invalid duration: '{text}'. Use format like '30m', '2h', '1d', "
+            "or a bare unit like 'hour' (defaults to 1)."
+        )
+    amount = int(match.group(1)) if match.group(1) else 1
+    return amount * _DURATION_MULTIPLIERS[match.group(2)[0]]
+
+
+def _parse_clock_time(text: str):
+    """Parse '9am'/'9:30am'/'14:00'/'noon' into a 24-hour (hour, minute) tuple."""
+    cleaned = text.strip().lower().replace(" ", "")
+    if not cleaned:
+        return None
+    if cleaned in ("noon", "midday"):
+        return (12, 0)
+    if cleaned == "midnight":
+        return (0, 0)
+    match = re.match(r"^(\d{1,2})(?::(\d{2}))?(am|pm)?$", cleaned)
+    if not match:
+        return None
+    hour = int(match.group(1))
+    minute = int(match.group(2) or 0)
+    meridiem = match.group(3)
+    if meridiem:
+        if not 1 <= hour <= 12:
+            return None
+        hour = hour % 12 + (12 if meridiem == "pm" else 0)
+    if hour > 23 or minute > 59:
+        return None
+    return (hour, minute)
+
+
+def _natural_every_to_cron(rest: str):
+    """Convert '<when> [at] <time>' to a 5-field cron expr, or None to fall back."""
+    tokens = rest.lower().replace(",", " ").split()
+    if not tokens:
+        return None
+    dow = _DAYSPEC_TO_CRON_DOW.get(tokens[0])
+    idx = 1
+    if dow is None:
+        days = []
+        idx = len(tokens)
+        for i, tok in enumerate(tokens):
+            if tok == "and":
+                continue
+            mapped = _WEEKDAY_TO_CRON_DOW.get(tok)
+            if mapped is None:
+                idx = i
+                break
+            if mapped not in days:
+                days.append(mapped)
+        if not days:
+            return None
+        dow = ",".join(days)
+    time_tokens = tokens[idx:]
+    if time_tokens and time_tokens[0] == "at":
+        time_tokens = time_tokens[1:]
+    if not time_tokens:
+        return None
+    parsed = _parse_clock_time(" ".join(time_tokens))
+    if parsed is None:
+        return None
+    hour, minute = parsed
+    return f"{minute} {hour} * * {dow}"
+
+
+def _cron_schedule_dict(expr: str, display: str, invalid_label: str):
+    """Validate a cron expression and build the stored schedule dict.
+
+    croniter (when installed — it is not a declared dependency of this
+    package) gives the same validation as the native scheduler; without it a
+    structural field check keeps clean installs working.
+    """
+    try:
+        from croniter import croniter  # optional, never a hard dependency
+    except ImportError:
+        croniter = None
+    if croniter is not None:
+        try:
+            croniter(expr)
+        except Exception as exc:
+            raise ValueError(f"Invalid {invalid_label} '{display}': {exc}") from exc
+    else:
+        fields = expr.split()
+        if len(fields) < 5 or not all(_CRON_FIELD_RE.match(f) for f in fields[:5]):
+            raise ValueError(f"Invalid {invalid_label} '{display}'")
+        # Approximate croniter's per-field range validation so semantically
+        # invalid expressions ('99 99 * * *', '0 9 * * 8') are rejected even
+        # without croniter. Bounds follow croniter: dow 0-7 (7 is the Sunday
+        # alias); names/wildcards are shape-checked above and skipped here.
+        bounds = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))
+        for field, (low, high) in zip(fields[:5], bounds):
+            for part in field.split(","):
+                for token in re.split(r"[-/]", part):
+                    if token in ("*", "") or not token.isdigit():
+                        continue
+                    if not low <= int(token) <= high:
+                        raise ValueError(
+                            f"Invalid {invalid_label} '{display}': field value "
+                            f"{token} out of range {low}-{high}"
+                        )
+    return {"kind": "cron", "expr": expr, "display": display}
+
+
+def _interval_schedule_dict(minutes: int):
+    return {"kind": "interval", "minutes": minutes, "display": f"every {minutes}m"}
+
+
+def _parse_schedule(schedule: str):
+    """Parse a schedule string into the scheduler's structured schedule dict.
+
+    Grammar (port of the native parser): '30m'/'every 30m' are recurring
+    intervals; 'in 30m' is a one-shot delay; 'every monday 9am' /
+    'weekdays at 9am' are weekly cron phrases; 5-6 field cron expressions are
+    cron; an ISO timestamp is one-shot.
+    """
+    schedule = schedule.strip()
+    original = schedule
+    schedule_lower = schedule.lower()
+
+    is_every = schedule_lower.startswith("every ")
+    rest = schedule[6:].strip() if is_every else schedule_lower
+    cron_expr = _natural_every_to_cron(rest)
+    if cron_expr is not None:
+        return _cron_schedule_dict(cron_expr, original, "schedule")
+    if is_every:
+        return _interval_schedule_dict(_parse_duration_minutes(rest))
+
+    parts = schedule.split()
+    if len(parts) >= 5 and all(re.match(r"^[A-Za-z\d\*/,\-]+$", p) for p in parts[:5]):
+        return _cron_schedule_dict(schedule, schedule, "cron expression")
+
+    if "T" in schedule or re.match(r"^\d{4}-\d{2}-\d{2}", schedule):
+        try:
+            dt = datetime.fromisoformat(schedule.replace("Z", "+00:00"))
+        except ValueError as exc:
+            raise ValueError(f"Invalid timestamp '{schedule}': {exc}") from exc
+        if dt.tzinfo is None:
+            # The native runtime anchors naive timestamps to its configured
+            # Hermes timezone; this port uses the host's local zone, so stored
+            # one-shot times can differ from the deployed scheduler's zone.
+            dt = dt.replace(tzinfo=datetime.now().astimezone().tzinfo)
+        return {
+            "kind": "once",
+            "run_at": dt.isoformat(),
+            "display": f"once at {dt.strftime('%Y-%m-%d %H:%M')}",
+        }
+
+    if schedule_lower.startswith("in "):
+        duration_str = schedule[3:].strip()
+        try:
+            minutes = _parse_duration_minutes(duration_str)
+        except ValueError:
+            raise ValueError(
+                f"Invalid duration '{duration_str}' after 'in '. Use e.g. 'in 30m', 'in 2h'."
+            ) from None
+        now = datetime.now().astimezone()
+        run_at = (now.astimezone(timezone.utc) + timedelta(minutes=minutes)).astimezone(now.tzinfo)
+        return {"kind": "once", "run_at": run_at.isoformat(), "display": f"once in {duration_str}"}
+
+    with contextlib.suppress(ValueError):
+        return _interval_schedule_dict(_parse_duration_minutes(schedule))
+
+    raise ValueError(
+        f"Invalid schedule '{original}'. Use an interval ('30m', 'every 2h'), a "
+        "one-shot delay ('in 30m'), a weekly phrase ('every monday 9am'), a cron "
+        "expression ('0 9 * * *'), or a timestamp ('2026-02-03T14:00:00')."
+    )
+
+
